---
/**
 * Logotipo de FPC Servicios (mismo arte que usa la app móvil). `claro` usa la versión blanca,
 * para fondos azules como el menú lateral; el resto usa la versión a color.
 */
interface Props {
  tamano?: 'normal' | 'grande';
  claro?: boolean;
}
const { tamano = 'normal', claro = false } = Astro.props;
const grande = tamano === 'grande';
---
<div class:list={['flex items-center gap-3', grande && 'flex-col text-center']}>
  <img
    src={claro ? '/logo-fpc-blanco.png' : '/logo-fpc.png'}
    alt="FPC Servicios"
    width="640"
    height="301"
    class:list={['h-auto', grande ? 'w-48' : 'w-28']}
  />
  <span class:list={['block text-xs', claro ? 'text-azul-100' : 'text-gris-500', grande && 'text-sm']}>
    {grande ? 'Distribución de Gases Industriales' : 'Administración'}
  </span>
</div>
